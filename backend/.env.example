FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
# Session pooler URI from Supabase > Connect. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Test suite only: the restricted role set up by db/test_role.sql.
TEST_DATABASE_URL=postgresql://connectsphere_test.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@connectsphere.io
